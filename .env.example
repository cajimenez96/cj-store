# ==============================================================================
# CJ Store - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (MongoDB)
# ------------------------------------------------------------------------------
# Connection URI to MongoDB Atlas or local instance.
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/cj-store?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/cj-store
MONGODB_URI=mongodb://localhost:27017/cj-store

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign JWT tokens for admin authentication.
# Generate a secure random string (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=your_super_secret_jwt_key_min_32_chars

# Admin panel credentials
ADMIN_USERNAME=admin
# Bcrypt hash of the admin password.
# (Default dev password 'fypZapatillas.DEV' hash: $2b$10$Zb/AGPZFkAFzn9Zikuc5GuowsybEueiaoP7b3VqFMY78NqrJHLURu)
ADMIN_PASSWORD_HASH=$2b$10$Zb/AGPZFkAFzn9Zikuc5GuowsybEueiaoP7b3VqFMY78NqrJHLURu

# ------------------------------------------------------------------------------
# 3. IMAGEKIT (Media & Cloud Image Storage)
# ------------------------------------------------------------------------------
# ImageKit credentials for uploading and hosting product photos.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ------------------------------------------------------------------------------
# 4. STOREFRONT & CHECKOUT DEFAULTS
# ------------------------------------------------------------------------------
# Store WhatsApp contact number (format: country code + number without symbols, e.g. 5491112345678).
NEXT_PUBLIC_WHATSAPP_PHONE=5491100000000

# Default bank transfer alias shown at checkout.
NEXT_PUBLIC_BANK_ALIAS=CJ.STORE
